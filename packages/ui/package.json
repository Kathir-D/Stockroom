{
  "name": "@stockroom/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./utils": {
      "types": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./api": {
      "types": "./src/lib/api/index.ts",
      "default": "./src/lib/api/index.ts"
    },
    "./styles/*": "./src/lib/styles/*",
    "./components/*": {
      "svelte": "./src/lib/components/*",
      "default": "./src/lib/components/*"
    },
    "./screens/*": {
      "svelte": "./src/lib/screens/*",
      "default": "./src/lib/screens/*"
    },
    "./stores/*": {
      "types": "./src/lib/stores/*",
      "default": "./src/lib/stores/*"
    }
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.46.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.0"
  },
  "peerDependencies": {
    "svelte": "^5",
    "tailwindcss": "^4"
  }
}
