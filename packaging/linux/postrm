#!/bin/sh
# purge removes the config, which holds the database password, and the
# drop-in setup wrote. Nothing here drops the database or deletes
# /var/lib/stockroom: those hold the school's records, and docs/INSTALL.md
# lists the commands for anyone who really wants them gone.
set -e

if [ "$1" = "purge" ]; then
  dropin=/etc/systemd/system/stockroom.service.d/user.conf
  if [ -f "$dropin" ]; then
    # A config chosen with setup --config holds the database password too.
    # Only that one file goes, never its directory.
    config=$(sed -n 's/^ExecStart=.* --config //p' "$dropin" | tail -n 1)
    if [ -n "$config" ] && [ -f "$config" ]; then
      rm -f "$config"
    fi
    rm -f "$dropin"
    rmdir /etc/systemd/system/stockroom.service.d 2>/dev/null || true
  fi
  rm -rf /etc/stockroom
fi
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi
exit 0
