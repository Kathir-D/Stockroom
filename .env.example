# Copy to .env and fill in. See CLAUDE.md §9.

# This file is the DEVELOPMENT .env. An install generates its own, with a
# random database password, in the install directory -- see docs/INSTALL.md.
#
# Direct Postgres connection. Port 54322 either way: the Supabase local stack
# in development, and deploy/docker-compose.yml maps the same host port on an
# installed machine, so one number appears in every doc, script and comment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Go API server listen address (localhost only)
SERVER_ADDR=127.0.0.1:8080

# Failsafe admin account — ensured to exist with is_admin=true on every server
# start (CLAUDE.md §7). Leave both blank for no failsafe admin; the server logs
# a warning and starts either way, and it does the same if a value is rejected.
# ADMIN_STUDENT_NUMBER: digits only, 1 to 32 of them (the ID cards encode six)
# ADMIN_PASSWORD: 8 to 72 characters
ADMIN_STUDENT_NUMBER=
ADMIN_PASSWORD=

# Where profile/asset photos are copied; served at /files/
UPLOADS_DIR=./uploads

# ------------------------------------------------------------- backups ---
# These three are a FIRST-BOOT SEED, not the setting. They fill the
# app_settings row the first time the server starts against a fresh database
# and are ignored on every start after that; from then on Admin -> Settings
# owns them (docs/design/backup.md §C.2). If .env won on every boot, a value
# an admin typed into the panel would silently revert overnight.
#
# Leave them blank and set everything in the admin panel instead -- that is
# the supported path, and the one docs/BACKUP-SETUP.md walks through.

# Where the dated folders and the restorable zip are written
BACKUP_DIR=

# Where item and profile photos are mirrored. Local only, never pushed
# off-site. Blank means photos are not mirrored at all.
PHOTO_BACKUP_DIR=

# The rclone remote holding the Google Drive backups. Admin -> Settings ->
# Google Drive -> Connect creates one for you, so this is only useful if
# rclone was already configured by hand.
RCLONE_REMOTE=

# Idle session timeout
SESSION_IDLE_MINUTES=10

# --------------------------------------------------- sign-in photo wall ---
# Two slowly scrolling columns of department photography behind the sign-in
# card (docs/design/signin-photo-wall.html). Entirely optional decoration.
#
# The switch is not in this file: the wall is off until an admin presses
# "Sign in with Google" in Admin -> Photo wall, which creates a read-only
# rclone remote and starts the wall with no restart. Until then no reel is
# built, no goroutine starts and the sign-in screen is exactly what it is today.
#
# SIGNIN_PHOTOS_REMOTE is only that remote's NAME, blank meaning gdrive-photos.
# Set it only for a remote made by hand under another name (configured
# drive.readonly, root_folder_id left BLANK so the folder is chosen per command).
SIGNIN_PHOTOS_REMOTE=

# The Drive folder the photos come from -- the long id out of a folder's share
# link, https://drive.google.com/drive/folders/<THIS>.
#
# A FIRST-BOOT SEED, NOT A SETTING. Admin -> Photo wall owns the live folder
# (§7): an admin pastes the share link there, and the value is kept in
# app_settings.signin_photos_folder_id from then on. This variable is copied
# into that column once, on the first start against a fresh database, and is
# ignored afterwards -- so a folder chosen in the panel is never out-voted by
# this file on the next restart. Leave it blank and choose the folder in the
# panel; that is the normal path.
#
# Treat it as a credential, not a label: a folder shared "anyone with the link"
# is readable by anyone holding it, which is why the panel never shows it back
# and why it is redacted from the backup export.
SIGNIN_PHOTOS_FOLDER_ID=

# Where normalized 900x600 tiles are cached. WIPED ON EVERY SERVER START, so
# it must be a directory of its own; the server refuses to start the feature
# if it finds files it did not put there.
SIGNIN_PHOTOS_DIR=./.cache/signin-photos

# Reel sizing. 48 tiles at ~120 KB is about 6 MB of disk; 32 per request is
# sixteen per column, and a sign-in and a half of runway. A served tile is
# deleted this many minutes later, which must stay comfortably longer than a
# page load.
SIGNIN_PHOTOS_COUNT=48
SIGNIN_PHOTOS_BATCH=32
SIGNIN_PHOTOS_TTL_MINUTES=15

# How often the folder is re-listed. Listing tens of thousands of files takes
# minutes, and the manifest survives a restart, so weekly is the default: the
# folder gains a batch of photographs after an event and is otherwise static.
SIGNIN_PHOTOS_MANIFEST_HOURS=168
