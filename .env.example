# Copy to .env and fill in. See CLAUDE.md §9.

# Direct Postgres connection (Supabase local stack, port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Go API server listen address (localhost only)
SERVER_ADDR=127.0.0.1:8080

# Failsafe admin account — ensured to exist with is_admin=true on every server
# start (CLAUDE.md §7). Leave both blank for no failsafe admin; the server logs
# a warning and starts either way, and it does the same if a value is rejected.
# ADMIN_STUDENT_NUMBER: digits only, 1 to 32 of them (the ID cards encode six)
# ADMIN_PASSWORD: 8 to 72 characters
ADMIN_STUDENT_NUMBER=
ADMIN_PASSWORD=

# Where profile/asset photos are copied; served at /files/
UPLOADS_DIR=./uploads

# Nightly CSV export target (point inside the Google Drive folder on the closet PC)
BACKUP_DIR=

# Idle session timeout
SESSION_IDLE_MINUTES=5
