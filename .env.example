# Copy to .env and fill in. See CLAUDE.md §9.

# Direct Postgres connection (Supabase local stack, port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Go API server listen address (localhost only)
SERVER_ADDR=127.0.0.1:8080

# Failsafe admin account — ensured to exist with is_admin=true on every server
# start (CLAUDE.md §7). Leave both blank for no failsafe admin; the server logs
# a warning and starts either way, and it does the same if a value is rejected.
# ADMIN_STUDENT_NUMBER: digits only, 1 to 32 of them (the ID cards encode six)
# ADMIN_PASSWORD: 8 to 72 characters
ADMIN_STUDENT_NUMBER=
ADMIN_PASSWORD=

# Where profile/asset photos are copied; served at /files/
UPLOADS_DIR=./uploads

# ------------------------------------------------------------- backups ---
# These three are a FIRST-BOOT SEED, not the setting. They fill the
# app_settings row the first time the server starts against a fresh database
# and are ignored on every start after that; from then on Admin -> Settings
# owns them (docs/design/backup.md §C.2). If .env won on every boot, a value
# an admin typed into the panel would silently revert overnight.
#
# Leave them blank and set everything in the admin panel instead -- that is
# the supported path, and the one docs/BACKUP-SETUP.md walks through.

# Where the dated folders and the restorable zip are written
BACKUP_DIR=

# Where item and profile photos are mirrored. Local only, never pushed
# off-site. Blank means photos are not mirrored at all.
PHOTO_BACKUP_DIR=

# The rclone remote holding the Google Drive backups. Admin -> Settings ->
# Google Drive -> Connect creates one for you, so this is only useful if
# rclone was already configured by hand.
RCLONE_REMOTE=

# Idle session timeout
SESSION_IDLE_MINUTES=10

# --------------------------------------------------- sign-in photo wall ---
# Two slowly scrolling columns of department photography behind the sign-in
# card (docs/design/signin-photo-wall.html). Entirely optional decoration.
#
# SIGNIN_PHOTOS_REMOTE is the switch: blank means no reel is built, no
# goroutine starts and the sign-in screen is exactly what it is today. Set it
# to the rclone remote holding the photos (see §3; the same rclone install the
# nightly backup uses, configured drive.readonly). The live folder itself is
# NOT set here -- an admin pastes a Drive link in the admin panel (§7).
SIGNIN_PHOTOS_REMOTE=

# Where normalized 900x600 tiles are cached. WIPED ON EVERY SERVER START, so
# it must be a directory of its own; the server refuses to start the feature
# if it finds files it did not put there.
SIGNIN_PHOTOS_DIR=./.cache/signin-photos

# Reel sizing. 48 tiles at ~120 KB is about 6 MB of disk; 16 per request is
# three sign-ins of runway. A served tile is deleted this many minutes later,
# which must stay comfortably longer than a page load.
SIGNIN_PHOTOS_COUNT=48
SIGNIN_PHOTOS_BATCH=16
SIGNIN_PHOTOS_TTL_MINUTES=15
